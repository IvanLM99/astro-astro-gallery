---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';

// Only use URL params on server, localStorage will be handled client-side
const lang = Astro.url.searchParams.get('lang') || 'es';
---

<Layout title="Gallery | Cosmos - Iván López" lang={lang}>
  <Navbar activeTab="gallery" lang={lang} />
  
  <main class="content-container">
    <section id="gallery-tab" class="fade-in">
      <Gallery lang={lang} />
    </section>
  </main>

  <Lightbox lang={lang} />
</Layout>
